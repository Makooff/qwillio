# ── General ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-vercel-app.vercel.app
API_BASE_URL=https://qwillio.onrender.com
TZ=Europe/Brussels

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Pending migrations are applied at boot in production, so a deploy is enough
# on its own (Render only runs preDeployCommand on paid instance types).
# Set to false to take that over manually.
AUTO_MIGRATE=true

# ── Auth / JWT ────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
# Configuration du portail de facturation (`bpc_…`), FACULTATIVE.
# Vide = configuration par défaut du compte, ce qui suffit tant qu'il n'y en a
# qu'une. La poser épingle celle qu'on a réglée, pour qu'une seconde
# configuration créée plus tard ne change pas le portail en silence.
# ⚠️ L'identifiant appartient à un MODE: un `bpc_` de test avec une clé live échoue.
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_LINK_BASIC=https://buy.stripe.com/xxx
STRIPE_LINK_PRO=https://buy.stripe.com/xxx
STRIPE_LINK_ENTERPRISE=https://buy.stripe.com/xxx
STRIPE_PRICE_BASIC_SETUP=price_xxx
STRIPE_PRICE_BASIC_MONTHLY=price_xxx
STRIPE_PRICE_PRO_SETUP=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_ENTERPRISE_SETUP=price_xxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx

# Agent AI modules — +$197/mo each, create in Stripe Dashboard then set IDs here
STRIPE_PRICE_MARKETING_AI=price_xxx
STRIPE_PRICE_REPUTATION_AI=price_xxx
STRIPE_PRICE_SCHEDULING_AI=price_xxx
STRIPE_PRICE_SUPPORT_AI=price_xxx
STRIPE_PRICE_CRM_AI=price_xxx
STRIPE_PRICE_DOCUMENT_AI=price_xxx
STRIPE_PRICE_LOCAL_SEO_AI=price_xxx
STRIPE_PRICE_LEAD_GEN_AI=price_xxx
STRIPE_PRICE_ANALYTICS_AI=price_xxx
# Bundle all 13 modules — $1497/mo
STRIPE_PRICE_ALL_AGENTS_BUNDLE=price_xxx

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=Qwillio <noreply@qwillio.com>
RESEND_REPLY_TO=contact@qwillio.com

# ── VAPI (Voice AI) ───────────────────────────────────────
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_PRIVATE_KEY=your_vapi_private_key
VAPI_ASSISTANT_ID=your_assistant_id
VAPI_PHONE_NUMBER=+1xxxxxxxxxx
VAPI_PHONE_NUMBER_ID=your_phone_number_id
VAPI_BASE_URL=https://api.vapi.ai
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret

# ── Voix : conformité et turn detection ───────────────────
# Divulgation IA + notice d'enregistrement au décroché (AI Act art. 50, RGPD).
# 'on' par défaut; 'off' n'est légal que hors UE.
VOICE_COMPLIANCE_GREETING=on
# Détecteur de fin de tour pour le français: 'vapi' (défaut documenté) ou
# 'livekit' (modèle multilingue, à valider sur de vrais appels avant adoption).
VOICE_FR_ENDPOINTING_PROVIDER=vapi
# Fallbacks fournisseurs — VIDES par défaut (un champ inconnu rejette
# l'assistant entier chez Vapi). À poser après validation sur un appel de test.
#
# ⚠️ Tant que ces deux lignes sont vides, il n'y a AUCUN secours: une panne
# Deepgram ou OpenAI est une panne totale. Le code est écrit, il n'attend que
# ces valeurs. Suggestions de départ: 'deepgram' pour le STT (ou 'elevenlabs',
# cf. docs/ETAT-DE-LART-2026.md §3), 'gpt-4o-mini' pour le LLM.
VOICE_LLM_FALLBACK_MODELS=
VOICE_STT_FALLBACK_PROVIDER=
# Modèle speech-to-speech. Le défaut du code a deux générations de retard:
# gpt-realtime-2.1 (07/2026) apporte le raisonnement configurable et 20 % de
# baisse de prix. À changer APRÈS avoir mesuré une latence de référence sur de
# vrais appels (fleetMetrics), sinon on ne saura pas si ça a aidé.
VOICE_REALTIME_MODEL=
# Achat automatique d'un numéro à l'onboarding quand la ligne partagée est
# prise. '1' strict; off par défaut: chaque activation ACHÈTE un numéro Twilio.
PHONE_AUTO_PROVISION=
PHONE_PROVISION_AREA_CODE=

# ── Twilio (SMS) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
SMS_ENABLED=false

# ── Discord Webhooks ──────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx
DISCORD_WEBHOOK_CALLS=https://discord.com/api/webhooks/xxx
DISCORD_WEBHOOK_LEADS=https://discord.com/api/webhooks/xxx
DISCORD_WEBHOOK_SYSTEM=https://discord.com/api/webhooks/xxx
DISCORD_WEBHOOK_ALERTS=https://discord.com/api/webhooks/xxx
# Dedicated errors channel (id 1458455361337167983). Create a webhook on that
# channel and paste the full URL here. Falls back to DISCORD_WEBHOOK_ALERTS.
DISCORD_WEBHOOK_ERRORS=https://discord.com/api/webhooks/xxx

# ── Apify (Google Maps scraping) ──────────────────────────
APIFY_API_KEY=your_apify_api_key
APIFY_ACTOR_ID=nwua9Gu5YkAT85Sp6

# ── AI APIs ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key
OPENAI_API_KEY=sk-your_key

# ── ELEVENLABS (real voice previews) ──────────────────────
# Needed by GET /my-dashboard/characters/:id/preview. Without it the endpoint
# answers 503 and the dashboard falls back to the robotic browser voice.
ELEVENLABS_API_KEY=your_elevenlabs_key

# ── VOIX TEMPS RÉEL, OPTION PAYANTE ───────────────────────
# Supplément à la minute pour le mode parole-à-parole, en euros.
#
# 0 (défaut) = l'option n'est PAS vendue: rien ne change.
#
# Poser un prix > 0 fait DEUX choses d'un coup, et c'est voulu:
#   1. le supplément est facturé chaque mois, à la minute réellement passée
#      en temps réel (colonne `client_calls.voice_mode`), sur une ligne Stripe
#      distincte de celle du dépassement ;
#   2. `voiceMode: auto` cesse de résoudre en temps réel. Sans ça, tous les
#      clients existants — qui sont en `auto` — découvriraient une option
#      payante sur leur facture sans l'avoir choisie.
# Le prix s'affiche aussi sur le bouton « Temps réel » du tableau de bord.
VOICE_REALTIME_SURCHARGE_EUR=0

# ── FISH AUDIO (auditionner une autre voix) ───────────────
# Pour ÉCOUTER Fish Audio sur nos propres phrases avant d'engager le travail de
# l'y brancher pour de vrai. Les aperçus sont hors du chemin d'appel: c'est le
# seul endroit où comparer sans rien risquer sur un appel réel.
#
# Vapi ne connaît PAS Fish Audio nativement (il parle à ElevenLabs, PlayHT,
# Azure, OpenAI, Cartesia, LMNT, Minimax, Rime). Les appels réels ne peuvent
# donc pas encore l'utiliser: il faudrait un endpoint `custom-voice` chez nous,
# soit un aller-retour de plus DANS le chemin audio. À décider APRÈS l'écoute.
#
# Pour auditionner:
#   1. FISH_AUDIO_API_KEY=...  (le palier gratuit suffit pour juger, mais il
#      n'accorde pas les droits commerciaux: écouter oui, vendre non)
#   2. FISH_AUDIO_VOICES=<voixElevenLabs>=<reference_id Fish>,...
#      Les deux catalogues sont étrangers l'un à l'autre. Sans cette table,
#      l'aperçu ÉCHOUE en disant `fish_voice_unmapped` — il ne retombe jamais
#      sur ElevenLabs, sinon on jugerait ElevenLabs en croyant juger Fish.
#   3. VOICE_PREVIEW_PROVIDER=fish
# Puis rouvrir le sélecteur de voix du tableau de bord et écouter.
FISH_AUDIO_API_KEY=
# s2-pro (payant, ~15 $/M caractères) · s2.1-pro-free · s1
FISH_AUDIO_MODEL=s2-pro
# 11labs (défaut) · fish
VOICE_PREVIEW_PROVIDER=11labs
FISH_AUDIO_VOICES=
FISH_AUDIO_DEFAULT_VOICE_ID=

# ── Prospecting / Automation ──────────────────────────────
CALLS_PER_DAY=50
AUTOMATION_START_HOUR=9
AUTOMATION_END_HOUR=19
AUTOMATION_DAYS=1,2,3,4,5
CALL_INTERVAL_MINUTES=20
PROSPECTION_DAILY_QUOTA=30
PROSPECTION_RADIUS_METERS=5000
PROSPECTION_CITIES=Bruxelles,Anvers,Gand
MIN_PRIORITY_SCORE=10

# ── Demo Links ────────────────────────────────────────────
DEMO_LINK_EN=https://qwillio.com/demo
DEMO_LINK_FR=https://qwillio.com/demo-fr

# ── DocuSign ─────────────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=your_integration_key
DOCUSIGN_USER_ID=your_user_guid
DOCUSIGN_ACCOUNT_ID=your_account_id
DOCUSIGN_PRIVATE_KEY=base64_encoded_rsa_private_key
DOCUSIGN_AUTH_SERVER=account.docusign.com
DOCUSIGN_WEBHOOK_SECRET=your_webhook_secret

# ── Admin ────────────────────────────────────────────────
ADMIN_EMAIL=makho.off@gmail.com
# Porte de service opérateur: l'en-tête x-admin-secret vaut rôle admin, sans
# JWT. Chaque usage est journalisé en warn (route + IP).
# ⚠️ 32 CARACTÈRES MINIMUM. En dessous, la porte est DÉSACTIVÉE plutôt
# qu'ouverte: un secret court est une clé maîtresse énumérable. Générer avec
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your_admin_secret

# ── Évals ────────────────────────────────────────────────
# Sans OPENAI_API_KEY, `npm run evals` ne s'exécute pas et le dit (annotation
# ::warning:: en CI). Poser EVALS_REQUIRE_KEY=1 rend cette absence FATALE:
# c'est le seul réglage où une étape verte signifie que les évals ont tourné.
EVALS_REQUIRE_KEY=

# ── Monitoring ───────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx
